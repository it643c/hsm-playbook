# .env.example
# Copy to .env → fill real values → NEVER commit .env

# ───── HSM Connection ─────
PKCS11_MODULE=/usr/lib/libpkcs11.so          # path to your vendor .so
SLOT_ID=0                                    # default slot for rotation script
HSM_PIN=12345678                             # SO or User PIN (change me!)

# ───── Backup & Audit ─────
BACKUP_PATH=/opt/hsm-backups
BACKUP_PASS=super-secret-backup-passphrase   # used for AES-256 encryption
AUDIT_LOG=/var/log/hsm-audit.jsonl

# ───── Partition Setup (hsm-partition-setup.sh) ─────
PARTITION_COUNT=4                            # how many tenant partitions to create
MAX_FAILED_LOGINS=5                          # zeroize after N failed logins
TAMPER_ERASE=true                            # physical tamper → full erase
HSM_VENDOR=thales                            # thales | luna | cloudhsm | securosys

# ───── Global Safety ─────
DRY_RUN=false                                # set true to see what would happen
